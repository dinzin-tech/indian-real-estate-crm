{% extends 'base.html.twig' %}

{% block title %}Add Lead - Indian Real Estate CRM{% endblock %}

{% block content %}
<div class="container">
    <h1>Add New Lead</h1>
    <form action="/leads" method="POST">
        <div class="form-group">
            <label for="name">Name *</label>
            <input type="text" id="name" name="name" required class="form-control">
        </div>
        
        <div class="form-group">
            <label for="phone">Phone (Indian +91) *</label>
            <input type="text" id="phone" name="phone" pattern="\+91[0-9]{10}" placeholder="+919876543210" required class="form-control">
            <small>Format: +91 followed by 10 digits</small>
        </div>
        
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" class="form-control">
        </div>
        
        <div class="form-group">
            <label for="property_preferences">Property Preferences</label>
            <textarea id="property_preferences" name="property_preferences" rows="3" class="form-control" placeholder="Location, budget, type (residential/commercial)"></textarea>
        </div>
        
        <div class="form-group">
            <label for="source_portal">Source Portal</label>
            <select id="source_portal" name="source_portal" class="form-control">
                <option value="">Select portal</option>
                {% for portal in portals %}
                <option value="{{ portal }}">{{ portal }}</option>
                {% endfor %}
            </select>
        </div>
        
        <div class="form-group">
            <label for="gstin">GSTIN (for B2B leads)</label>
            <input type="text" id="gstin" name="gstin" pattern="[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}" class="form-control" placeholder="22AAAAA0000A1Z5">
        </div>
        
        <div class="form-group">
            <label for="rera_number">RERA Number</label>
            <input type="text" id="rera_number" name="rera_number" class="form-control" placeholder="e.g., P-BPL-17-1234">
            <small>State-specific RERA registration number</small>
        </div>
        
        <button type="submit" class="btn btn-success">Save Lead</button>
        <a href="/leads" class="btn btn-secondary">Cancel</a>
    </form>
</div>
{% endblock %}