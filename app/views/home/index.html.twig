{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block content %}

<h1>Indian Real Estate CRM</h1>
<p>Welcome to your new simple-mvc application with Indian-specific features.</p>

<div class="features">
    <h2>Core Features</h2>
    <ul>
        <li><a href="/leads">Lead/Contact Management</a> - Manage leads with local portal integration (99acres, MagicBricks, etc.)</li>
        <li><a href="/stamp-duty">Stamp Duty Calculator</a> - Calculate stamp duty & registration charges across Indian states</li>
        <li><a href="/leads">WhatsApp Integration</a> - Send WhatsApp messages to leads (via any lead's edit page)</li>
        <li>RERA Field - Already added to leads for compliance</li>
    </ul>
</div>
<!-- <div>
    {# {{- form|raw -}} #}
    {% autoescape false %}
        {{ form }}
    {% endautoescape %}

</div> -->

<div>
    <button hx-get="{{ route('greeetings') }}" hx-target="#content" hx-swap="innerHTML">Load </button>
</div>
<div id="content">
    <p>Click the button to load content.</p>
</div>

{% endblock %}